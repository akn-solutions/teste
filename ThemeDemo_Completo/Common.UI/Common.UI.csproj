<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

	<PropertyGroup>
		<TargetFrameworks>net481</TargetFrameworks>
		<!-- Usa a versão mais recente do C# compatível com o Framework netstandard(version) -->
		<LangVersion>latest</LangVersion>
		<Platforms>x64</Platforms>
		<UseWPF>true</UseWPF>
		<AssemblyName>Common.UI</AssemblyName>
		<!-- Output correto para x64 -->
		<OutputPath>bin\x64\$(Configuration)\</OutputPath>
		<!--evita de criar a sub pasta com nome do framework -->
		<!--antes ->  bin\x64\Debug\netstandard2.0-->
		<!--depois ->  bin\x64\Debug-->
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<!--Obriga a gerar o arquivo .pdb que permite o debug-->
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<!--Impede de gerar o arquivo .pdb que permite o debug-->
		<DebugSymbols>false</DebugSymbols>
		<DebugType>none</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Resources\**" />
		<EmbeddedResource Remove="Resources\**" />
		<None Remove="Resources\**" />
	</ItemGroup>

	<!-- Xaml de Themes: SDK trata como Page, precisa ser Resource -->
