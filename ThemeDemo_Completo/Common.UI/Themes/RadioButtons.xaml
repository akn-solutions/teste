<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib">




    <!--#region Style RadioButton-->
    <Style x:Key="StyleRadioButton" TargetType="{x:Type RadioButton}">
        <Setter Property="BorderBrush" Value="{DynamicResource CorCream}" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="radioButtonBorder"
                            Margin="1,1,1,1"
                            BorderBrush="{DynamicResource CorGrayLight}"
                            BorderThickness="1"
                            CornerRadius="100">
                            <Grid x:Name="markGrid" Margin="2">
                                <Ellipse
                                    x:Name="optionMark"
                                    MinWidth="9"
                                    MinHeight="9"
                                    Fill="{DynamicResource CorBlueLight}"
                                    Opacity="0" />
                            </Grid>
                        </Border>
                        <ContentPresenter
                            x:Name="contentPresenter"
                            Grid.Column="1"
                            Margin="1,1,0,0"
                            Focusable="False"
                            RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="radioButtonBorder" Property="BorderBrush" Value="{DynamicResource CorGreen500}" />
                            <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="{DynamicResource CorGreen500}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="true">
                            <Setter TargetName="optionMark" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="optionMark" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->





    <!--#region Style RadioButton Images-->
    <Style x:Key="StyleRadioButtonImages_AKN" TargetType="{x:Type RadioButton}">
        <Setter Property="BorderBrush" Value="{DynamicResource CorCream}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid SnapsToDevicePixels="True">
                        <StackPanel Height="75" Orientation="Horizontal">
                            <Border
                                x:Name="radioButtonBorder"
                                Width="16"
                                Height="16"
                                Margin="0,-20,15,0"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="100">
                                <Grid x:Name="markGrid">
                                    <Ellipse
                                        x:Name="optionMark"
                                        Width="10"
                                        Height="10"
                                        Fill="{DynamicResource CorBlueLight}" />
                                </Grid>
                            </Border>
                            <StackPanel Orientation="Vertical">
                                <Border
                                    Width="60"
                                    Height="50"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource CorTransparent}"
                                    BorderThickness="0" />
                                <ContentPresenter
                                    x:Name="contentPresenter"
                                    Width="Auto"
                                    Height="26"
                                    Margin="0,5,0,0"
                                    HorizontalAlignment="Center"
                                    Focusable="False"
                                    RecognizesAccessKey="True" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="radioButtonBorder" Property="BorderBrush" Value="{DynamicResource CorYellow}" />
                            <Setter TargetName="contentPresenter" Property="TextElement.Foreground" Value="{DynamicResource CorYellow}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="true">
                            <Setter TargetName="optionMark" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="optionMark" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!--#endregion-->    

</ResourceDictionary>