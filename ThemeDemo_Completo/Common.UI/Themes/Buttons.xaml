<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib">

    <!-- Default Button -->
    <Style x:Key="StyleDefaultButton">
        <Setter Property="Control.Foreground" Value="{DynamicResource CorBlack}" />
        <Setter Property="Control.BorderBrush" Value="{DynamicResource CorGreen500}" />
        <Setter Property="Control.FontSize" Value="12" />
        <Setter Property="Control.Width" Value="120" />
        <Setter Property="Control.Height" Value="{DynamicResource ControlsHeight}" />
        <Style.Triggers>
            <Trigger Property="Control.IsMouseOver" Value="True">
                <Setter Property="Control.Foreground" Value="{DynamicResource CorBlack}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    
    <!-- Button Clear -->
    <Style
        x:Key="StyleButtonClear"
        BasedOn="{StaticResource StyleDefaultButton}"
        TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource CorWhite}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5"
                        Cursor="Hand"
                        SnapsToDevicePixels="true">
                        <ContentPresenter
                            x:Name="contentPresenter"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="False"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <!--<Setter Property="Foreground" Value="{DynamicResource CorBlack}"/>-->
                <Setter Property="Background" Value="{DynamicResource CorGreen500}" />
            </Trigger>
        </Style.Triggers>
    </Style>    

    <!-- Button Clear Image -->
    <Style
        x:Key="StyleButtonClearImage"
        BasedOn="{StaticResource StyleDefaultButton}"
        TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource CorWhite}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Width" Value="100" />
        <Setter Property="Height" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5"
                        Cursor="Hand"
                        SnapsToDevicePixels="true">
                        <ContentPresenter
                            x:Name="contentPresenter"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Focusable="False"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <!--<Setter Property="Foreground" Value="{DynamicResource CorBlack}"/>-->
                <Setter Property="Background" Value="{DynamicResource CorGreen500}" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <!--#region Style Button New / Criar / Aplicar-->
    <Style
        x:Key="StyleButtonOk"
        BasedOn="{StaticResource StyleDefaultButton}"
        TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource CorGreen500}" />
        <Setter Property="Foreground" Value="{DynamicResource CorWhite}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CorGreen500}" />
        <Setter Property="Width" Value="{DynamicResource ButtonsWidth}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5"
                        Cursor="Hand">
                        <Grid Width="110">
                            <TextBlock
                                Height="20"
                                Margin="5,2,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{TemplateBinding Content}" />
                            <TextBlock
                                Margin="0,0,5,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="Kanit Medium"
                                FontSize="20"
                                Text="→" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CorGreen600}" />
                <Setter Property="Foreground" Value="{DynamicResource CorWhite}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CorGreen500}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CorGreen700}" />
                <Setter Property="Foreground" Value="{DynamicResource CorWhite}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CorGreen500}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--#endregion-->
    

    <!--#region Style Button Cancelar-->
    <Style
        x:Key="StyleButtonCancel"
        BasedOn="{StaticResource StyleDefaultButton}"
        TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource CorRed500}" />
        <Setter Property="Foreground" Value="{DynamicResource CorWhite}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CorRed500}" />
        <Setter Property="Width" Value="{DynamicResource ButtonsWidth}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5"
                        Cursor="Hand">
                        <Grid Width="115">
                            <TextBlock
                                Height="20"
                                Margin="5,2,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{TemplateBinding Content}" />
                            <TextBlock
                                Margin="0,0,-10,5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="GOST Common"
                                FontSize="30"
                                Text="+">
                                <TextBlock.RenderTransform>
                                    <TransformGroup>
                                        <RotateTransform Angle="45" />
                                    </TransformGroup>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CorRed600}" />
                <Setter Property="Foreground" Value="{DynamicResource CorWhite}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CorRed500}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CorRed700}" />
                <Setter Property="Foreground" Value="{DynamicResource CorWhite}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CorRed500}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!--#endregion-->
    
    
    <!-- Button Adicionar-->
    <Style
        x:Key="StyleButtonAdd"
        BasedOn="{StaticResource StyleDefaultButton}"
        TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource CorWhite}" />
        <Setter Property="Width" Value="{DynamicResource ButtonsWidth}" />
        <Setter Property="Template">
