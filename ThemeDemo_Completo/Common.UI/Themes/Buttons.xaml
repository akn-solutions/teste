                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5"
                        Cursor="Hand">
                        <Grid Width="120">
                            <TextBlock
                                Height="20"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Text="{TemplateBinding Content}" />
                            <TextBlock
                                Margin="0,0,10,8"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontFamily="GOST Common"
                                FontSize="30"
                                Text="+" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <!--<Setter Property="Foreground" Value="{DynamicResource CorBlack}"/>-->
                <Setter Property="Background" Value="{DynamicResource CorGreen500}" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- Button Adicionar Circular -->
    <Style
        x:Key="StyleButtonAddCircular"
        BasedOn="{StaticResource StyleDefaultButton}"
        TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource CorWhite}" />
        <Setter Property="Width" Value="35" />
        <Setter Property="Height" Value="35" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="17.5"
                        Cursor="Hand">
                        <Grid>
                            <TextBlock
                                Height="20"
                                Margin="0,0,0,6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Arial"
                                FontSize="22"
                                Foreground="{TemplateBinding Foreground}"
                                Text="+" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <!--<Setter Property="Foreground" Value="{DynamicResource CorBlack}"/>-->
                <Setter Property="Background" Value="{DynamicResource CorGreen500}" />
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- Button Parametros -->
    <Style
        x:Key="StyleButtonConfiguracoes"
        BasedOn="{StaticResource StyleDefaultButton}"
        TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource CorAmbar500}" />
        <Setter Property="Foreground" Value="{DynamicResource CorWhite}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CorAmbar500}" />
        <Setter Property="Width" Value="148" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5"
                        Cursor="Hand">
                        <StackPanel Margin="10,0" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="15"
                                Text="&#xE713;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                Text="{TemplateBinding Content}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CorAmbar600}" />
                <Setter Property="Foreground" Value="{DynamicResource CorWhite}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource CorAmbar700}" />
                <Setter Property="Foreground" Value="{DynamicResource CorWhite}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    

    <!-- Button Remove -->
    <Style x:Key="StyleButtonRemove" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource Button.Static.Background_Remove}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Width" Value="{DynamicResource ButtonFolderHeight}" />
        <Setter Property="Height" Value="{DynamicResource ButtonFolderHeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border1" Background="{TemplateBinding Background}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="border1" Property="Background" Value="{DynamicResource Button.MouseOver.Background_Remove}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    

