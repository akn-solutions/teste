<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib">


    <Style x:Key="StyleWindowXAML" TargetType="{x:Type Window}">
        <Setter Property="Background" Value="{DynamicResource CorTransparent}" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="Icon" Value="/Common.UI;component/Assets/Icons/logo_akn.ico"/>
    </Style>

    <ControlTemplate x:Key="TemplateWindow_AKN" TargetType="{x:Type Window}">
        <Grid>
            <Border
                Background="{DynamicResource CorWhite}"
                BorderBrush="{DynamicResource CorCream}"
                BorderThickness="1"
                CornerRadius="8"
                SnapsToDevicePixels="True" />
            <StackPanel
                HorizontalAlignment="Center"
                SnapsToDevicePixels="True"
                Style="{DynamicResource StyleStackPanelTitleBar}">
                <TextBlock
                    VerticalAlignment="Bottom"
                    FontFamily="Kanit"
                    FontSize="16"
                    Text="{TemplateBinding Title}" />
            </StackPanel>
            <AdornerDecorator>
                <ContentPresenter />
            </AdornerDecorator>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>