<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib">

    <!-- Color Brushes -->
    <SolidColorBrush x:Key="CorBlack" Color="#1A1A18" />
    <SolidColorBrush x:Key="CorWhite" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CorBlueLight" Color="#3BD1E8" />
    <SolidColorBrush x:Key="CorBlueSkyLight" Color="#FFBDE6BE" />
    <SolidColorBrush x:Key="CorBlue" Color="#FF042271" />
    <SolidColorBrush x:Key="CorRed500" Color="#ef4444" />
    <!--Normal-->
    <SolidColorBrush x:Key="CorRed600" Color="#dc2626" />
    <!--Houver-->
    <SolidColorBrush x:Key="CorRed700" Color="#b91c1c" />
    <!--Pressed-->
    <SolidColorBrush x:Key="CorGreen500" Color="#22c55e " />
    <!--Normal-->
    <SolidColorBrush x:Key="CorGreen600" Color="#16a34a " />
    <!--Houver-->
    <SolidColorBrush x:Key="CorGreen700" Color="#15803d" />
    <!--Pressed-->
    <SolidColorBrush x:Key="CorAmbar500" Color="#f59e0b"/>
    <!--Normal-->
    <SolidColorBrush x:Key="CorAmbar600" Color="#d97706"/>
    <!--Houver-->
    <SolidColorBrush x:Key="CorAmbar700" Color="#b45309"/>
    <!--Pressed-->
    <SolidColorBrush x:Key="CorBlue500" Color="#3b82f6"/>
    <!--Normal-->
    <SolidColorBrush x:Key="CorBlue600" Color="#2563eb"/>
    <!--Houver-->
    <SolidColorBrush x:Key="CorBlue700" Color="#1d4ed8"/>
    <!--Pressed-->
    <SolidColorBrush x:Key="CorGray" Color="#878580" />
    <SolidColorBrush x:Key="CorGrayLight" Color="#FFCDCDCD" />
    <SolidColorBrush x:Key="CorGrayLightMidle" Color="#F0F0F0" />
    <SolidColorBrush x:Key="CorCream" Color="#FFF7F6F2" />
    <SolidColorBrush x:Key="CorTransparent" Color="Transparent" />
    <SolidColorBrush x:Key="CorYellow" Color="#FFFFCC49" />


    <!-- Button Remove -->
    <ImageBrush
        x:Key="Button.Static.Background_Remove"
        ImageSource="/Common.UI;component/Assets/Images/remove.png"
        Stretch="UniformToFill" />
    <ImageBrush
        x:Key="Button.MouseOver.Background_Remove"
        ImageSource="/Common.UI;component/Assets/Images/remove_select.png"
        Stretch="UniformToFill" />

    <!-- Button Folder -->
    <ImageBrush
        x:Key="Button.Static.Background_Folder"
        ImageSource="/Common.UI;component/Assets/Images/folder.png"                
        Stretch="UniformToFill" />
    <ImageBrush
        x:Key="Button.MouseOver.Background_Folder"
        ImageSource="/Common.UI;component/Assets/Images/folder_select.png"
        Stretch="UniformToFill" />

    <!-- Button Settings -->
    <ImageBrush
        x:Key="Button.Static.Background_Settings"
        ImageSource="/Common.UI;component/Assets/Images/settings.png"
        Stretch="UniformToFill" />
    <ImageBrush
        x:Key="Button.MouseOver.Background_Settings"
        ImageSource="/Common.UI;component/Assets/Images/settings_select.png"
        Stretch="UniformToFill" />

    <!-- Button Minimize -->
    <ImageBrush
        x:Key="Button.Static.Background_Minimize"
        ImageSource="/Common.UI;component/Assets/Images/minimize.png"
        Stretch="UniformToFill" />
    <ImageBrush
        x:Key="Button.MouseOver.Background_Minimize"
        ImageSource="/Common.UI;component/Assets/Images/minimize_select.png"
        Stretch="UniformToFill" />

    <!-- Button SWPart -->
    <ImageBrush
        x:Key="Button.Static.Background_SWPart"
        ImageSource="/Common.UI;component/Assets/Images/sw_doc_part.png"
        Stretch="UniformToFill" />
    <ImageBrush
        x:Key="Button.MouseOver.Background_SWPart"
        ImageSource="/Common.UI;component/Assets/Images/sw_doc_part_select.png"
        Stretch="UniformToFill" />

    <!-- Button File TXT -->
    <ImageBrush
        x:Key="Button.Static.Background_FileTxt"
        ImageSource="/Common.UI;component/Assets/Images/file_txt.png"
        Stretch="UniformToFill" />
    <ImageBrush
        x:Key="Button.MouseOver.Background_FileTxt"
        ImageSource="/Common.UI;component/Assets/Images/file_txt_select.png"
        Stretch="UniformToFill" />

    <!-- Button TextBoxWithPlaceHolder Nome -->
    <VisualBrush x:Key="textPlaceHolderNome"
        AlignmentX="Center"
        Stretch="None"
        TileMode="None">
        <VisualBrush.Visual>
            <TextBlock Foreground="{StaticResource CorGray}" Text="Insira o Parâmetro..." />
        </VisualBrush.Visual>
    </VisualBrush>

    <!-- Button TextBoxWithPlaceHolder Valor -->
    <VisualBrush
        x:Key="textPlaceHolderValor"
        AlignmentX="Center"
        Stretch="None"
        TileMode="None">
        <VisualBrush.Visual>
            <TextBlock
                Padding="10,0,0,0"
                Foreground="{StaticResource CorGray}"
                Text="Insira o Valor..." />
        </VisualBrush.Visual>
    </VisualBrush>

</ResourceDictionary>