<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib">

    <!-- Estilo para a barra de título do Superior-->
    <Style x:Key="StyleStackPanelTitleBar" TargetType="{x:Type StackPanel}">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Height" Value="30" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ToolTip" Value="Clique para movimentar o formulário" />
    </Style>

    <!--  Quadrados com cores que são usados prara fazer legenda de objetos como itens de um Tree View  -->
    <ControlTemplate x:Key="spLegenda">
        <StackPanel
            Height="20"
            Margin="5,0,5,0"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <Rectangle
                Width="15"
                Height="15"
                Fill="{TemplateBinding Background}" />
            <TextBlock
                Margin="5,2,0,0"
                FontSize="14"
                Text="{TemplateBinding Tag}" />
        </StackPanel>
    </ControlTemplate>
</ResourceDictionary>