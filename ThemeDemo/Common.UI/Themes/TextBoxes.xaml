<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:System="clr-namespace:System;assembly=mscorlib">


    <!-- TextBox ReadOnly PRINCIPAL-->
    <Style x:Key="StyleTextBoxReadOnly" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{DynamicResource ControlsHeight}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource CorGreen500}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border
                        x:Name="border"
                        Background="{DynamicResource CorCream}"
                        BorderBrush="{DynamicResource CorGrayLight}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource CorTransparent}"
                                FontWeight="Bold"
                                Text="{TemplateBinding TextBox.Tag}" />
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="5,0,5,0"
                                VerticalAlignment="Center"
                                Focusable="false"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden">
                                <ScrollViewer.InputBindings>
                                    <MouseBinding
                                        Command="ApplicationCommands.SelectAll"
                                        MouseAction="LeftDoubleClick" />
                                </ScrollViewer.InputBindings>
                            </ScrollViewer>
                                
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource CorGreen500}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    

    <!-- TextBox CustomBackground -->
    <Style x:Key="StyleTextBoxCustomBackground" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{DynamicResource ControlsHeight}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource CorGreen500}" />
        <Setter Property="SelectionOpacity" Value="0.4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border
                        x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource CorGrayLight}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                Margin="5,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource CorTransparent}"
                                FontWeight="Bold"
                                Text="{TemplateBinding TextBox.Tag}" />
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="5,0,5,0"
                                VerticalAlignment="Center"
                                Focusable="false"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden">
                                <ScrollViewer.InputBindings>
                                    <MouseBinding
                                        Command="ApplicationCommands.SelectAll"
                                        MouseAction="LeftDoubleClick" />
                                </ScrollViewer.InputBindings>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource CorGreen500}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    

    <!--#region Style TextBoxWithPlaceHolder Nome-->
    <Style
    x:Key="StyleTextBoxWithPlaceHolderName"
    BasedOn="{StaticResource StyleTextBoxReadOnly}"
    TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{DynamicResource ControlsHeight}" />
        <Setter Property="IsReadOnly" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border
                    x:Name="border"
                    Background="{DynamicResource CorGrayLightMidle}"
                    BorderBrush="{DynamicResource CorGrayLight}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <ScrollViewer
                            x:Name="PART_ContentHost"
                            Padding="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            Focusable="false"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource CorGreen500}" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource textPlaceHolderNome}" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource textPlaceHolderNome}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--#region Style TextBoxWithPlaceHolder Valor-->
    <Style
    x:Key="StyleTextBoxWithPlaceHolderValor"
    BasedOn="{StaticResource StyleTextBoxReadOnly}"
    TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="{DynamicResource ControlsHeight}" />
        <Setter Property="IsReadOnly" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border
                    x:Name="border"
                    Background="{DynamicResource CorGrayLightMidle}"
                    BorderBrush="{DynamicResource CorGrayLight}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="5">
                        <StackPanel Orientation="Horizontal">
                            <ScrollViewer
                            x:Name="PART_ContentHost"
                            Padding="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            Focusable="false"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource CorGreen500}" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource textPlaceHolderValor}" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="border" Property="Background" Value="{DynamicResource textPlaceHolderValor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


</ResourceDictionary>