<Window x:Class="Common.UI.Views.ProgressBarView"    
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"        
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:Common.UI.ViewModels"
        Height="435" Width="366" WindowStartupLocation="CenterScreen" Topmost="True" Style="{DynamicResource StyleWindow}" Template="{DynamicResource TemplateWindow_AKN}">
    

    <Grid>
        <Grid Margin="0,46,0,0" Height="300" Width="300" HorizontalAlignment="Center" VerticalAlignment="Top">
            <!-- Arco principal -->
            <Path Stroke="#FF40EF79" Data="{Binding ArcGeometry}" StrokeThickness="{Binding StrokeThickness}" 
                  Width="300" Height="300"
                  Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <!-- Arco interno -->
            <Path Stroke="#FFAFDC65" Data="{Binding ArcSubGeometry}" StrokeThickness="{Binding StrokeThicknessSub}" 
                  Visibility="{Binding ArcSubVisibility}"
                  Width="300" Height="300"                  
                  Stretch="None" HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Texto central -->
            <StackPanel HorizontalAlignment="Center" Orientation="Vertical" Margin="0,85,0,85">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <TextBlock Text="{Binding ArcText, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" FontFamily="Arial" FontSize="70" Foreground="#FF5B5B5B"/>
                    <TextBlock Text="%" VerticalAlignment="Bottom" FontFamily="Arial" FontSize="35" Foreground="#FF5B5B5B" Padding="0,0,0,10"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Visibility="{Binding ArcSubTextVisibility, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}">
                    <TextBlock Text="{Binding ArcSubText, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" FontFamily="Arial" FontSize="35" Foreground="#FF5B5B5B"/>
                    <TextBlock Text="%" Background="Transparent" VerticalAlignment="Bottom" FontFamily="Arial" FontSize="17.5" Foreground="#FF5B5B5B" Padding="0,0,0,5"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Texto inferior -->
        <TextBlock Visibility="{Binding TxtNFilesVisibility}" Text="{Binding TxtProgresso, Mode=OneWay, UpdateSourceTrigger=PropertyChanged}" FontSize="20" HorizontalAlignment="Center" TextAlignment="Center"
           TextTrimming="CharacterEllipsis" MaxWidth="342" VerticalAlignment="Bottom" Margin="0,0,0,45" />
        <TextBlock  FontWeight="Bold" FontSize="20" MaxWidth="342" Margin="0,393,0,0" HorizontalAlignment="Center" TextAlignment="Center"> 
            <Run Text="{Binding TxtNFilesStart}"/>
            <Run Text=" de "/>
            <Run Text="{Binding TxtNFilesEnd}"/>
            <Run Text=" Arquivos"/>
        </TextBlock>
    </Grid>
</Window>